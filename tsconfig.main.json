{
  "extends": "@electron-toolkit/tsconfig/main",
  "compilerOptions": {
    "outDir": "dist/main",
    "rootDir": "src/main",
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "dist", "src/renderer"]
}
